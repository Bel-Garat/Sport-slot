
# SportSlot - Local environment configuration
# Copy this file to .env and replace placeholder values.
# Never put real passwords or secrets in this file.

# PostgreSQL database hosted on Supabase
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Ports for local development (defaults shown)
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
VENUE_SERVICE_PORT=4002
RESERVATION_SERVICE_PORT=4003
REVIEW_SERVICE_PORT=4004
AUDIT_SERVICE_PORT=4005

# Where the gateway forwards requests (defaults shown)
AUTH_SERVICE_URL=http://localhost:4001
VENUE_SERVICE_URL=http://localhost:4002
RESERVATION_SERVICE_URL=http://localhost:4003
REVIEW_SERVICE_URL=http://localhost:4004
AUDIT_SERVICE_URL=http://localhost:4005

# Base URL of the gateway used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# JWT authentication (auth-service and gateway)
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# Google sign-in: OAuth 2.0 Client ID (type Web application) from Google Cloud Console
# auth-service verifies ID tokens for it, the frontend shows the Google button with it
GOOGLE_CLIENT_ID=761406248105-u0v6ac0fif8gj3njrp43l4thteicpqkv.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=761406248105-u0v6ac0fif8gj3njrp43l4thteicpqkv.apps.googleusercontent.com

# Gateway authentication
GATEWAY_SECRET=replace-with-a-different-secure-random-secret
FRONTEND_ORIGIN=http://localhost:3000
