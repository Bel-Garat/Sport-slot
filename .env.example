
# SportSlot - Local environment configuration
# Copy this file to .env and replace placeholder values.
# Never put real passwords or secrets in this file.

# PostgreSQL database hosted on Supabase
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Ports for local development (defaults shown)
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
VENUE_SERVICE_PORT=4002
RESERVATION_SERVICE_PORT=4003
REVIEW_SERVICE_PORT=4004
AUDIT_SERVICE_PORT=4005

# Where the gateway forwards requests (defaults shown)
AUTH_SERVICE_URL=http://localhost:4001
VENUE_SERVICE_URL=http://localhost:4002
RESERVATION_SERVICE_URL=http://localhost:4003
REVIEW_SERVICE_URL=http://localhost:4004
AUDIT_SERVICE_URL=http://localhost:4005

# Base URL of the gateway used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api
